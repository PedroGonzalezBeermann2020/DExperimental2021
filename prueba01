      "source": [
        "# prompt: crear una gráfica del sin(3x) para x=0 hasta 10\n",
        "\n",
        "import numpy as np\n",
        "import matplotlib.pyplot as plt\n",
        "\n",
        "# Generar datos\n",
        "x = np.linspace(0, 10, 100)  # 100 puntos entre 0 y 10\n",
        "y = np.sin(3 * x)\n",
        "\n",
        "# Crear la gráfica\n",
        "plt.plot(x, y)\n",
        "\n",
        "# Añadir etiquetas y título\n",
        "plt.xlabel(\"x\")\n",
        "plt.ylabel(\"sin(3x)\")\n",
        "plt.title(\"Gráfica de sin(3x)\")\n",
        "\n",
        "# Mostrar la gráfica\n",
        "plt.grid(True)\n",
        "plt.show()\n"
      ]
    }
